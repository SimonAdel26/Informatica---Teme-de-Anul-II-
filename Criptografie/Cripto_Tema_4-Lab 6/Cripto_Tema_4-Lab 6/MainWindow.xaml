<Window x:Class="Cripto_Tema_4_Lab_6.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cripto_Tema_4_Lab_6"
        mc:Ignorable="d"
        Title="MainWindow" Height="550" Width="950">
    <Grid Margin="10">

        <Grid.RowDefinitions>

            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="90"/>
            <RowDefinition Height="90"/>
            <RowDefinition Height="90"/>
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="50"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Input File -->
        
        <TextBlock Grid.Row="0"
           Grid.Column="0"
           Text="Input File:"
           FontSize="13"
           VerticalAlignment="Center"
           HorizontalAlignment="Center"/>

        <TextBox Grid.Row="0"
         Grid.Column="1"
         Height="40"
         x:Name="txtInputFile"/>

        <Button Grid.Row="0"
        Grid.Column="2"
        Width="120"
        Height="40"
        Content="Browse"
        FontSize="13"
        Click="BtnBrowseInput_Click"/>

        <!-- Output File -->

        <TextBlock Grid.Row="1"
        Grid.Column="0"
        Text="Output File:"
        FontSize="13"
        VerticalAlignment="Center"
        HorizontalAlignment="Center"/>

        <TextBox Grid.Row="1"
         Grid.Column="1"
         Height="40"
         x:Name="txtOutputFile"/>

        <Button Grid.Row="1"
        Grid.Column="2"
        Width="120"
        Height="40"
        Content="Browse"
        FontSize="13"
        Click="BtnBrowseOutput_Click"/>

        <!-- Algoritm -->

        <TextBlock Grid.Row="2"
        Grid.Column="0"
        Text="Algoritm:"
        FontSize="13"
        VerticalAlignment="Center"
        HorizontalAlignment="Center"/>

        <ComboBox Grid.Row="2"
                      Grid.Column="1"
                      Width="300"
                      Height="40"
                      x:Name="cmbAlgoritm"
                      VerticalAlignment="Center">

            <ComboBoxItem Content="DES"
                          FontSize="13"/>
            <ComboBoxItem Content="TripleDES"
                          FontSize="13"/>
            <ComboBoxItem Content="AES"
                          FontSize="13"/>
            <ComboBoxItem Content="Rijndael"
                          FontSize="13"/>
            <ComboBoxItem Content="RC2"
                          FontSize="13"/>

        </ComboBox>


        <!-- Key -->
        <TextBlock Grid.Row="2"
        Grid.Column="3"
        VerticalAlignment="Center"
        HorizontalAlignment="Center"
        FontSize="15"
        Text="Key:"/>

        <TextBox Grid.Row="2"
        Grid.Column="5"
        Height="40"
        Width="230"
        x:Name="KeyText"
        VerticalAlignment="Center"/>

        <!-- Operation Mode -->
        <TextBlock Grid.Row="3"
        Grid.Column="0"
        VerticalAlignment="Center"
        Text="Mod de operare:"
        FontSize="13"/>

        <ComboBox Grid.Row="3"
                      Grid.Column="1"
                      Width="180"
                      Height="40"
                      x:Name="cmbOperationMode"
                      SelectionChanged ="cmbOperationMode_SelectionChanged" 
                      VerticalAlignment="Center">

            <ComboBoxItem Content="ECB"
                          FontSize="13"/>
            <ComboBoxItem Content="CBC"
                          FontSize="13"/>
            <ComboBoxItem Content="OFB"
                          FontSize="13"/>
            <ComboBoxItem Content="CFB"
                          FontSize="13"/>
            <ComboBoxItem Content="CTS"
                          FontSize="13"/>

        </ComboBox>

        <!-- IV -->
        <TextBlock Grid.Row="3"
        Grid.Column="3"
        VerticalAlignment="Center"
        HorizontalAlignment="Center"
        FontSize="13"
        Text="IV:"/>

        <TextBox Grid.Row="3"
        Grid.Column="5"
        Width="230"
        Height="40"
        x:Name="IVText"
        VerticalAlignment="Center"/>

        <!-- Padding -->
        <TextBlock Grid.Row="4"
        Grid.Column="0"
        VerticalAlignment="Center"
        HorizontalAlignment="Center"
        FontSize="13"
        Text="Padding:"/>

        <ComboBox Grid.Row="4"
        Grid.Column="1"
        Height="40"
        x:Name="cmbPadding"
        SelectionChanged ="cmbPadding_SelectionChanged">

            <ComboBoxItem Content="None"
                          FontSize="13"/>
            <ComboBoxItem Content="PKCS7"
                          FontSize="13"/>
            <ComboBoxItem Content="Zeros"
                          FontSize="13"/>
            <ComboBoxItem Content="ANSIX923"
                          FontSize="13"/>
            <ComboBoxItem Content="ISO10126"
                          FontSize="13"/>

        </ComboBox>

        <!-- Buttons -->

        <StackPanel Grid.Row="5"
                        Grid.Column="0"
                        Grid.ColumnSpan="6"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

            <Button Content="Encrypt"
                        Width="180"
                        Height="55"
                        Margin="10"
                    Click="BtnEncrypt_Click"/>

            <Button Content="Decrypt"
                        Width="180"
                        Height="55"
                        Margin="10"
                    Click="BtnDecrypt_Click"/>

        </StackPanel>

    </Grid>
</Window>
